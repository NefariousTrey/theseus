# /etc/theseus/env  (root:root 0600). systemd reads it for the web service; the theseus user and the lockbox cannot read it.
THESEUS_ADMIN_TOKEN=change-me-at-least-16-chars
# Vultr Serverless Inference key (agent step). Leave empty for rule-based order and wording.
VULTR_INFERENCE_API_KEY=
THESEUS_LLM_BASE=https://api.vultrinference.com/v1
THESEUS_LLM_MODEL=deepseek-v4.1-flash-1017
THESEUS_LLM_MAX_CALLS=40
THESEUS_AGENT_DAILY=60
# Extra targets such as Express (admin only): see deploy/presets.example.json
THESEUS_PRESETS=/etc/theseus/presets.json
# Scanning any public GitHub repo by URL: off unless set to 1 (admin only even then)
THESEUS_ALLOW_REPO_URL=0
THESEUS_HOST_LABEL=Vultr Cloud Compute
